BACKEND_PORT=8000
FRONTEND_PORT=8501
# auto: Gemini when a key is set, otherwise clearly labelled reference mode.
# reference: offline cards and self-check. gemini: require live AI (errors stay visible).
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
CONTEXTCUE_DB_PATH=data/contextcue.db
# Docker/Python 3.12 uses durable asynchronous LangGraph checkpoints.
CONTEXTCUE_ASYNC_CHECKPOINTER=true
